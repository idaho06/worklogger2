// app.rc - Windows resource file for WorkLogger
// This embeds the application icon and version information

// Application icon (ID 1 is used by Windows as the main app icon)
1 ICON "resources\\wl.ico"

// Version information
1 VERSIONINFO
FILEVERSION     2,0,1,0
PRODUCTVERSION  2,0,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "AkinoSoft"
            VALUE "FileDescription",  "WorkLogger - Daily Work Log Editor"
            VALUE "FileVersion",      "2.0.1.0"
            VALUE "InternalName",     "worklogger2"
            VALUE "LegalCopyright",   "Copyright (C) 2024-2026 idaho06"
            VALUE "OriginalFilename", "worklogger2.exe"
            VALUE "ProductName",      "WorkLogger"
            VALUE "ProductVersion",   "2.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
